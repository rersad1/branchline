{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workspace Manager",
  "version": "0.1.1",
  "identifier": "dev.agent-workspace.manager",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Workspace Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Local Windows and WSL Git workspace",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Agent Workspace Manager"
      }
    },
    "resources": {
      "assets/terminal-host-windows.exe": "terminal-host-windows.exe"
    }
  }
}
